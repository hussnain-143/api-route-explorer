{
  "name": "api-route-explorer",
  "displayName": "API Route Explorer",
  "description": "Discover, analyze, search, and navigate API routes directly inside VS Code.",
  "version": "1.5.0",
  "publisher": "hussnain-143",
  "publisherDisplayName": "Hussnain Ahmed",
  "author": {
    "name": "Hussnain Ahmed",
    "url": "https://github.com/hussnain-143"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hussnain-143/api-route-explorer"
  },
  "bugs": {
    "url": "https://github.com/hussnain-143/api-route-explorer/issues"
  },
  "homepage": "https://github.com/hussnain-143/api-route-explorer#readme",
  "keywords": [
    "api",
    "routes",
    "router",
    "express",
    "nextjs",
    "fastify",
    "nestjs",
    "rest",
    "endpoints",
    "navigation"
  ],
  "icon": "resources/icons/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "API Route Explorer",
      "properties": {
        "apiRouteExplorer.defaultGrouping": {
          "type": "string",
          "enum": [
            "file",
            "framework",
            "method",
            "health"
          ],
          "enumDescriptions": [
            "Group routes by source file and module folder (default)",
            "Group routes by framework (Express, Next.js, Fastify, NestJS)",
            "Group routes by HTTP method (GET, POST, PUT, DELETE...)",
            "Group routes by health status (Healthy, Warnings, Errors)"
          ],
          "default": "file",
          "description": "Default grouping mode for the API Route Explorer TreeView."
        },
        "apiRouteExplorer.baseUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Base URL used when copying full route URLs (e.g. http://localhost:3000)."
        },
        "apiRouteExplorer.scan.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional folder or file patterns to exclude during workspace scanning (extends built-in exclusions)."
        },
        "apiRouteExplorer.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh and update route analysis when files are modified in the workspace."
        },
        "apiRouteExplorer.openapi.title": {
          "type": "string",
          "default": "",
          "description": "Custom API title for generated OpenAPI specifications (defaults to package.json name or workspace title)."
        },
        "apiRouteExplorer.openapi.version": {
          "type": "string",
          "default": "",
          "description": "Custom API version for generated OpenAPI specifications (defaults to package.json version or 1.0.0)."
        },
        "apiRouteExplorer.openapi.includeSourceMetadata": {
          "type": "boolean",
          "default": true,
          "description": "Include x-api-route-explorer source code metadata in generated OpenAPI specifications."
        },
        "apiRouteExplorer.httpClient.timeout": {
          "type": "number",
          "default": 10000,
          "description": "Timeout in milliseconds for HTTP Client requests (default: 10000ms / 10s)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiRouteExplorer",
          "title": "API Route Explorer",
          "icon": "resources/icons/activity-bar.svg"
        }
      ]
    },
    "views": {
      "apiRouteExplorer": [
        {
          "id": "apiRouteExplorer.routesView",
          "name": "API Routes",
          "icon": "resources/icons/activity-bar.svg"
        },
        {
          "id": "apiRouteExplorer.analysisView",
          "name": "Route Analysis",
          "icon": "resources/icons/activity-bar.svg"
        }
      ],
      "explorer": [
        {
          "id": "apiRouteExplorer.explorerRoutesView",
          "name": "API Routes",
          "icon": "resources/icons/activity-bar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "apiRouteExplorer.scan",
        "title": "Scan Routes",
        "category": "API Route Explorer"
      },
      {
        "command": "apiRouteExplorer.refresh",
        "title": "Refresh Routes",
        "category": "API Route Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "apiRouteExplorer.searchRoutes",
        "title": "Search Routes",
        "category": "API Route Explorer",
        "icon": "$(search)"
      },
      {
        "command": "apiRouteExplorer.openRoute",
        "title": "Open Route",
        "category": "API Route Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "apiRouteExplorer.openFile",
        "title": "Open File",
        "category": "API Route Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "apiRouteExplorer.copyRoute",
        "title": "Copy Route",
        "category": "API Route Explorer",
        "icon": "$(clippy)"
      },
      {
        "command": "apiRouteExplorer.copyRoutePath",
        "title": "Copy Route Path",
        "category": "API Route Explorer",
        "icon": "$(copy)"
      },
      {
        "command": "apiRouteExplorer.copyCurl",
        "title": "Copy as cURL",
        "category": "API Route Explorer",
        "icon": "$(terminal)"
      },
      {
        "command": "apiRouteExplorer.copyRouteUrl",
        "title": "Copy Route URL",
        "category": "API Route Explorer",
        "icon": "$(link)"
      },
      {
        "command": "apiRouteExplorer.copyRouteDefinition",
        "title": "Copy Route Definition",
        "category": "API Route Explorer",
        "icon": "$(quote)"
      },
      {
        "command": "apiRouteExplorer.filterByMethod",
        "title": "Filter Routes by Method",
        "category": "API Route Explorer",
        "icon": "$(filter)"
      },
      {
        "command": "apiRouteExplorer.filterRoutes",
        "title": "Filter Routes...",
        "category": "API Route Explorer",
        "icon": "$(filter)"
      },
      {
        "command": "apiRouteExplorer.groupBy",
        "title": "Group Routes By...",
        "category": "API Route Explorer",
        "icon": "$(list-tree)"
      },
      {
        "command": "apiRouteExplorer.searchSimilarRoutes",
        "title": "Search Similar Routes",
        "category": "API Route Explorer",
        "icon": "$(search)"
      },
      {
        "command": "apiRouteExplorer.exportRoutes",
        "title": "Export Routes...",
        "category": "API Route Explorer",
        "icon": "$(export)"
      },
      {
        "command": "apiRouteExplorer.statusBarMenu",
        "title": "API Route Explorer Menu",
        "category": "API Route Explorer"
      },
      {
        "command": "apiRouteExplorer.showStatistics",
        "title": "Show Route Statistics",
        "category": "API Route Explorer",
        "icon": "$(graph)"
      },
      {
        "command": "apiRouteExplorer.exportOpenApi",
        "title": "Export OpenAPI Specification...",
        "category": "API Route Explorer",
        "icon": "$(file-code)"
      },
      {
        "command": "apiRouteExplorer.exportOpenApiYaml",
        "title": "Export OpenAPI Specification (YAML)",
        "category": "API Route Explorer",
        "icon": "$(file-code)"
      },
      {
        "command": "apiRouteExplorer.exportOpenApiJson",
        "title": "Export OpenAPI Specification (JSON)",
        "category": "API Route Explorer",
        "icon": "$(json)"
      },
      {
        "command": "apiRouteExplorer.openHttpClient",
        "title": "Test API",
        "category": "API Route Explorer",
        "icon": "$(send)"
      },
      {
        "command": "apiRouteExplorer.analyzeRoute",
        "title": "Analyze Route",
        "category": "API Route Explorer",
        "icon": "$(pulse)"
      },
      {
        "command": "apiRouteExplorer.viewRouteOpenApi",
        "title": "View OpenAPI Operation",
        "category": "API Route Explorer",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "apiRouteExplorer.searchRoutes",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@1"
        },
        {
          "command": "apiRouteExplorer.groupBy",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@2"
        },
        {
          "command": "apiRouteExplorer.filterRoutes",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@3"
        },
        {
          "command": "apiRouteExplorer.refresh",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@4"
        },
        {
          "command": "apiRouteExplorer.exportRoutes",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@5"
        },
        {
          "command": "apiRouteExplorer.showStatistics",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "apiRouteExplorer.analyzeRoute",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "inline@1"
        },
        {
          "command": "apiRouteExplorer.openHttpClient",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "inline@2"
        },
        {
          "command": "apiRouteExplorer.viewRouteOpenApi",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "inline@3"
        },
        {
          "command": "apiRouteExplorer.openFile",
          "when": "viewItem == apiRouteExplorer.fileGroup",
          "group": "inline@1"
        },
        {
          "command": "apiRouteExplorer.analyzeRoute",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "navigation@1"
        },
        {
          "command": "apiRouteExplorer.openHttpClient",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "navigation@2"
        },
        {
          "command": "apiRouteExplorer.viewRouteOpenApi",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "navigation@3"
        },
        {
          "command": "apiRouteExplorer.openRoute",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "navigation@4"
        },
        {
          "command": "apiRouteExplorer.openFile",
          "when": "viewItem == apiRouteExplorer.route || viewItem == apiRouteExplorer.fileGroup",
          "group": "navigation@5"
        },
        {
          "command": "apiRouteExplorer.searchSimilarRoutes",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "navigation@6"
        },
        {
          "command": "apiRouteExplorer.copyRoute",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "copy@1"
        },
        {
          "command": "apiRouteExplorer.copyRoutePath",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "copy@2"
        },
        {
          "command": "apiRouteExplorer.copyRouteUrl",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "copy@3"
        },
        {
          "command": "apiRouteExplorer.copyRouteDefinition",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "copy@4"
        },
        {
          "command": "apiRouteExplorer.copyCurl",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "copy@5"
        }
      ],
      "commandPalette": [
        {
          "command": "apiRouteExplorer.openRoute",
          "when": "false"
        },
        {
          "command": "apiRouteExplorer.openFile",
          "when": "false"
        },
        {
          "command": "apiRouteExplorer.copyRoute",
          "when": "false"
        },
        {
          "command": "apiRouteExplorer.copyRoutePath",
          "when": "false"
        },
        {
          "command": "apiRouteExplorer.copyRouteUrl",
          "when": "false"
        },
        {
          "command": "apiRouteExplorer.copyRouteDefinition",
          "when": "false"
        },
        {
          "command": "apiRouteExplorer.searchSimilarRoutes",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test:unit": "mocha --ui tdd out/test/routeParser.test.js",
    "test": "vscode-test",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
