{
  "name": "api-route-explorer",
  "displayName": "API Route Explorer",
  "description": "Discover, organize, and navigate API routes directly inside VS Code.",
  "version": "0.7.0",
  "publisher": "api-route-explorer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/api-route-explorer/api-route-explorer"
  },
  "icon": "resources/icons/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiRouteExplorer",
          "title": "API Route Explorer",
          "icon": "resources/icons/activity-bar.svg"
        }
      ]
    },
    "views": {
      "apiRouteExplorer": [
        {
          "id": "apiRouteExplorer.routesView",
          "name": "API Routes",
          "icon": "resources/icons/activity-bar.svg"
        },
        {
          "id": "apiRouteExplorer.analysisView",
          "name": "Route Analysis",
          "icon": "resources/icons/activity-bar.svg"
        }
      ],
      "explorer": [
        {
          "id": "apiRouteExplorer.explorerRoutesView",
          "name": "API Routes",
          "icon": "resources/icons/activity-bar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "apiRouteExplorer.scan",
        "title": "Scan Routes",
        "category": "API Route Explorer"
      },
      {
        "command": "apiRouteExplorer.refresh",
        "title": "Refresh Routes",
        "category": "API Route Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "apiRouteExplorer.searchRoutes",
        "title": "Search Routes",
        "category": "API Route Explorer",
        "icon": "$(search)"
      },
      {
        "command": "apiRouteExplorer.openRoute",
        "title": "Open Route",
        "category": "API Route Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "apiRouteExplorer.openFile",
        "title": "Open File",
        "category": "API Route Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "apiRouteExplorer.copyRoute",
        "title": "Copy Route",
        "category": "API Route Explorer",
        "icon": "$(clippy)"
      },
      {
        "command": "apiRouteExplorer.copyRoutePath",
        "title": "Copy Route Path",
        "category": "API Route Explorer",
        "icon": "$(copy)"
      },
      {
        "command": "apiRouteExplorer.copyCurl",
        "title": "Copy as cURL",
        "category": "API Route Explorer",
        "icon": "$(terminal)"
      },
      {
        "command": "apiRouteExplorer.filterByMethod",
        "title": "Filter Routes",
        "category": "API Route Explorer",
        "icon": "$(filter)"
      },
      {
        "command": "apiRouteExplorer.statusBarMenu",
        "title": "API Route Explorer Menu",
        "category": "API Route Explorer"
      },
      {
        "command": "apiRouteExplorer.showStatistics",
        "title": "Show Route Statistics",
        "category": "API Route Explorer",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "apiRouteExplorer.searchRoutes",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@1"
        },
        {
          "command": "apiRouteExplorer.filterByMethod",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@2"
        },
        {
          "command": "apiRouteExplorer.refresh",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@3"
        },
        {
          "command": "apiRouteExplorer.scan",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@4"
        },
        {
          "command": "apiRouteExplorer.showStatistics",
          "when": "view == apiRouteExplorer.routesView || view == apiRouteExplorer.explorerRoutesView",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "apiRouteExplorer.copyRoutePath",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "inline@1"
        },
        {
          "command": "apiRouteExplorer.openRoute",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "inline@2"
        },
        {
          "command": "apiRouteExplorer.openFile",
          "when": "viewItem == apiRouteExplorer.fileGroup",
          "group": "inline@1"
        },
        {
          "command": "apiRouteExplorer.openRoute",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "navigation@1"
        },
        {
          "command": "apiRouteExplorer.openFile",
          "when": "viewItem == apiRouteExplorer.route || viewItem == apiRouteExplorer.fileGroup",
          "group": "navigation@2"
        },
        {
          "command": "apiRouteExplorer.copyRoute",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "copy@1"
        },
        {
          "command": "apiRouteExplorer.copyRoutePath",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "copy@2"
        },
        {
          "command": "apiRouteExplorer.copyCurl",
          "when": "viewItem == apiRouteExplorer.route",
          "group": "copy@3"
        }
      ],
      "commandPalette": [
        {
          "command": "apiRouteExplorer.openRoute",
          "when": "false"
        },
        {
          "command": "apiRouteExplorer.openFile",
          "when": "false"
        },
        {
          "command": "apiRouteExplorer.copyRoute",
          "when": "false"
        },
        {
          "command": "apiRouteExplorer.copyRoutePath",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test:unit": "mocha --ui tdd out/test/routeParser.test.js",
    "test": "vscode-test",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
